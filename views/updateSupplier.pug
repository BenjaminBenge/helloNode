doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/css/index.css')
  ul
    .home-space
      li
        a.active.home-btn(href='#home') Home
    li
      a.login-btn(href='#news') Stock
    li
      a.contact-btn(href='#contact ') About
    li
      a.about-btn(href='#about ') SignUp
  title Document
h1 Update Supplier
.space-around-manager-login
  .manager-login
    h4 Please enter the Supplier Details
    form(action='/updateSupplier?id=' + supplier._id, method='post')
      .imgcontainer
        img.avatar(src='/img/supplier2.jpg' alt='Avatar')
      label(for='fname') Supplier Name
      br
      input#fname(type='text' name='supplierName' value=supplier.supplierName)
      br
      br
      label(for='fname') Supplier Location
      br
      input#Sname(type='text' name='supplierLocation' value=supplier.supplierLocation)
      br
      br
      label(for='fname') Contact
      br
      input#email(type='text' name='contact' value=supplier.contact)
      br
      br
      input(type='submit' value='Update Supplier')
      label
      .lower-login-section(style='background-color: #f1f1f1')
        button.cancelbtn(type='button') Cancel
        