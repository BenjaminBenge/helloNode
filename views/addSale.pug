doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    title Add Sale
    link(rel='stylesheet', href='/css/index.css') // Ensure this path is valid

  body
    // Navbar (optional)
    ul
      li
        a.home-btn(href='/') Home
      li
        a.login-btn(href='/stock') Stock
      li
        a.contact-btn(href='/about') About
      li
        a.about-btn(href='/login') Login

    h1 Add Sale

    .manager-login
      form(action="/addSale", method="POST", id="addSaleForm")
        label(for="customerName") Customer Name:
        input(type="text", name="customerName", required)

        br

        label(for="date") Date:
        input(type="date", name="date", required)

        br

        label(for="productToBuy") Select Product:
        select#productToBuy(name="productToBuy", required)
          each product in products
            option(value=product._id) #{product.producename}

        br

        label(for="quantity") Quantity:
        input(type="number", name="quantity", min="1", required)

        br
        br

        input(type="submit", value="Submit")
