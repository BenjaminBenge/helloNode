doctype html
html
  head
    title Add Sale
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/css/index.css")
  body
    ul
      .home-space
      li
        a.home-btn(href="/") Home
      li
        a.login-btn(href="/products") Products
      li
        a.contact-btn(href="/services") Services
      li
        a.about-btn(href="/logout") Logout

    h1 Add New Sale

    .space-around-manager-login
      .manager-login
        h4 Please make a sale here

        if error
          p(style="color: red; font-weight: bold;") #{error}

        form#myForm(method="POST", action=`/addSale/${product._id}`)
          .imgcontainer 
            img.avatar(src='/img/flowers.jpg', alt='Avatar')
          
          label(for="buyername") Customer:
          input(type="text", name="buyername", )

          label(for="product") Product:
          select(name="product", disabled)
            option(value=product._id selected)= product.productname

          label(for="amountToBuy") Quantity:
          input(type="number", name="amountToBuy", id="amountToBuy", min="1", required)

          label(for="unitCost") Unit Cost:
          input(type="number", name="unitCost", id="unitCost", value=product.unitprice, readonly)

          label(for="totalPaid") Total Paid:
          input(type="number", name="totalPaid", id="totalPaid", readonly)

          label(for="salesPerson") Sold By:
          input(type="text", name="salesPerson", value=firstName, readonly)

          label(for="branch") Branch:
          input(type="text", name="branch", value=branch, readonly)

          input(type="submit", value="Submit")

          .lower-login-section(style="background-color: #f1f1f1")
            a.cancelbtn(href="/products") Cancel

    script.
      const unitCostInput = document.getElementById('unitCost');
      const amountToBuyInput = document.getElementById('amountToBuy');
      const totalPaidInput = document.getElementById('totalPaid');

      amountToBuyInput.addEventListener('input', function () {
        const qty = parseFloat(amountToBuyInput.value) || 0;
        const cost = parseFloat(unitCostInput.value) || 0;
        totalPaidInput.value = (qty * cost).toFixed(2);
      });
