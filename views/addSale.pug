head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/css/index.css')
  ul
    .home-space
      li
        a.active.home-btn(href='#home') Home
    li
      a.login-btn(href='#news') Stock
    li
      a.contact-btn(href='#contact ') About
    li
      a.about-btn(href='#about ') SignUp
  title Document
h1 Add Sale
.space-around-manager-login
  .manager-login
    h4 Please make a sale here
    form#myForm(action="/addSales" method="post")
      .imgcontainer
        img.avatar(src='/img/flowers.jpg' alt='Avatar')
      div
        div
          label(for='buyername') Buyer Name
          br
          br
          input#buyerName(type='text' name='buyername' value='')
          br
          br
          small#buyerNameError
        label(for='productToBuy') Product to Buy:
        br
        br
        select#productToBuy(name='productToBuy' form='')
          option(value='Cow Peas') Cow Peas
          option(value='Beans') Beans
          option(value='G-Nuts') G-Nuts
          option(value='Soy Beans') Soy Beans
          option(value='Maize') Maize
        br
        br
      div
        label(for='typeOfProduce') Type Of Produce:
        br
        br
        select#typeOfProduce(name='typeOfProduce')
          option(value='Legume') Legume
          option(value='Flour') Flour
          option(value='Nuts') Nuts
        br
        br
      div
        label(for='amountToBuy') Amount to buy in Kilos
        br
        br
        input#amountToBuy(type='number' name='amountToBuy' value='1')
        br
        br
        small#amountToBuyError
      div
        label(for='unitCost') Unit Cost in Ugx
        br
        input#unitCost(type='text' name='unitCost' value='')
        br
        br
      div
        label(for='fname') Total Paid
        br
        br
        input#totalPaid(type='text' name='totalPaid' value='')
        br
        br
      div
        div
          label(for='branch') Branch :
          br
          br
          select#branch(name='branch')
            option(value='') --Select--
            option(value='Maganjo') Maganjo
            option(value='Matugga') Matugga
          br
      input(type='submit' value='Submit')
      .lower-login-section(style='background-color: #f1f1f1')
        button.cancelbtn(type='button') Cancel
script(src='/public/js/validateSale.js')
