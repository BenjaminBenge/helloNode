doctype html
html
  head
    title Credit Sales
    link(rel="stylesheet", href="/styles.css") // Optional stylesheet
  body
    h1 Credit Sales

    table(border="1", cellpadding="8", cellspacing="0")
      thead
        tr
          th Product Name
          th Buyer Name
          th Quantity
          th Unit Cost
          th Amount Due
          th Date
          th Actions
      tbody
        each sale in sales
          tr
            td= sale.productname.productname
            td= sale.buyername
            td= sale.quantity
            td ₦#{sale.unitCost}
            td ₦#{sale.amountDue}
            td= sale.createdAt.toDateString()
            td
              a(href=`/sales/editCreditSale/${sale._id}`) Edit
              form(action=`/sales/deleteCreditSale/${sale._id}`, method="POST", style="display:inline;")
                button(type="submit", onclick="return confirm('Are you sure you want to delete this credit sale?')") Delete
