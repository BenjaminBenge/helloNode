

doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  head
    // Required meta tags
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(rel='stylesheet' href='/css/index.css')
    ul
      .home-space
        li
          a.active.home-btn(href='#home') Home
      li
        a.login-btn(href='#news') Stock
      li
        a.contact-btn(href='#contact ') About
      li
        a.about-btn(href='#about ') Login
    h1 Sales Records


    h2 All Sales
    table#customers(border="1")
      thead
        tr
          th Product
          th Buyer
          th Quantity (kg)
          th Unit Price
          th Total Paid
          th Sold By
          th Branch
          th Date
      tbody
      if sales && sales.length
        each sale in sales
          tr
            td #{sale.productname.productname}
            td #{sale.buyername}
            td #{sale.amountToBuy}
            td #{sale.unitprice}
            td #{sale.totalPaid}
            td #{sale.soldby}
            td #{sale.branch}
            td #{moment(sale.createdAt).format("YYYY-MM-DD HH:mm")}


