doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/CSS/login.css')
  title Document
h2 Sales List
.topnav
  a.active(href='#home') Home
  a(href='/managerDash') Manager
  a(href='/salesAgentDash') SalesAgent
  a(href='/directorDash') Director
div
  table
    thead 
      tr
        th First Name
        th Last Name
        th Amount Sold
        th Quantity Purchased
        th Update
        th Delete
    tbody 
      if sales.length 
        each sale in sales
          tr
            td #{sale.firstname}
            td #{sale.lastname}
            td #{sale.AmountSold}
            td #{sale.amountPaid}
            //- td #{}add Date here
            td 
              a.btn.btn-primary.btn-block(href="/updateSale/"+sale._id) Update
            td 
              form(action="/deleteSale" method = "post")
                input(type="hidden" name="id" value=sale.id)
                button.btn.btn-danger.btn-block(type="submit") Delete 


