doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet' integrity='sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH' crossorigin='anonymous')
  link(rel='stylesheet' href='/CSS/sales.css')
  title Document
h2 Update Sales 
.topnav
  a.active(href='#home') Home
  a(href='/managerDash') Manager
  a(href='/salesAgentDash') SalesAgent
  a(href='/directorDash') Director
div
.one
  form(action='/updateSale?id='+sale._id method='post')
    label(for='fname') First name:
    br
    input#fname( name='firstname' value=sale.firstname)
    br
    label(for='lname') Last name:
    br
    input#lname( name='lastname' value=sale.lastname)
    br
    br
    label(for='fname') Amount Purchased in Shillings:
    br
    input#fname( name='AmountSold' value=sale.AmountSold)
    input(type='submit' value='Submit')
