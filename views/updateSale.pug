doctype html
html
  head
    title Update Sale
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/css/index.css")
  body
    ul
      .home-space
      li
        a.home-btn(href="/") Home
      li
        a.login-btn(href="/products") Products
      li
        a.contact-btn(href="/services") Services
      li
        a.about-btn(href="/logout") Logout

    h1 Update Sale

    .space-around-manager-login
      .manager-login
        h4 Please update the sale details

        if error
          p(style="color: red; font-weight: bold;") #{error}

        form(action=`/updateSale/${sale._id}` method="post")
          .imgcontainer 
            img.avatar(src='/img/flowers.jpg', alt='Avatar')

          // Hidden product ID
          input(type="hidden", name="productId", value=product._id)

          label(for="buyername") Customer:
          input(type="text", name="buyername", value=sale.buyername)

          label(for="product") Product:
          select(name="product" disabled)
            option(value=product._id selected)= product.productname

          label(for="amountToBuy") Quantity:
          input(type="number", name="amountToBuy", id="amountToBuy", min="1", value=sale.amountToBuy, required)

          label(for="unitprice") Unit Cost:
          input(type="number", name="unitprice", id="unitprice", value=product.unitprice, readonly)

          label(for="totalPaid") Total Paid:
          input(type="number", name="totalPaid", id="totalPaid", value=sale.totalPaid, readonly)

          label(for="soldby") Sold By:
          input(type="text", name="soldby", value=sale.soldby, readonly)

          label(for="branch") Branch:
          input(type="text", name="branch", value=sale.branch, readonly)

          input(type="submit", value="Update Sale")

          .lower-login-section(style="background-color: #f1f1f1")
            a.cancelbtn(href="/products") Cancel

    script.
      const unitCostInput = document.getElementById('unitprice');
      const amountToBuyInput = document.getElementById('amountToBuy');
      const totalPaidInput = document.getElementById('totalPaid');

      amountToBuyInput.addEventListener('input', function () {
        const qty = parseFloat(amountToBuyInput.value) || 0;
        const cost = parseFloat(unitCostInput.value) || 0;
        totalPaidInput.value = (qty * cost).toFixed(2);
      });
