doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet' href='/css/index.css')
    title Add Credit Customer
  body
    ul
      .home-space
        li
          a.active.home-btn(href='#home') Home
      li
        a.login-btn(href='#news') Stock
      li
        a.contact-btn(href='#contact') About
      li
        a.about-btn(href='#about') SignUp

    h1 Credit Customers

    .space-around-manager-login
      .manager-login
        h4 Please enter customer’s details

        if error
          p(style='color: red; font-weight: bold;') #{error}

        form#form(action='/addCreditCustomer' method='POST' onsubmit='return validateUserForm(event)')
          .imgcontainer
            img.avatar(src='/img/flowers.jpg' alt='Avatar')

          label(for='fname') Name Of Buyer
          br
          input#buyerName(type='text' name='buyername' value='')
          br
          small#buyerNameError
          br

          label(for='gender') Gender:
          br
          select#gender(name='sex')
            option(value='') Select gender
            option(value='Male') Male
            option(value='Female') Female
          small#genderError
          br

          label(for='NIN') NIN:
          br
          input#NINumber(type='text' name='NIN')
          br
          small#NINumberError
          br

          label(for='phoneNumber') Phone Number:
          br
          input#phoneNumber(type='text' name='telePhoneNumber')
          br
          small#phoneNumberError
          br

          label(for='dueDate') Due Date:
          br
          input#dueDate(type='date' name='dueDate')
          br
          small#dueDateError
          label(for='address') Address:
          br
          input#address(type='text' name='address')
          br
          small#addressError
          br

          label(for='city') City:
          br
          input#city(type='text' name='city')
          br
          small#cityError
          br
          input(type='submit' value='Submit')

          .lower-login-section(style='background-color: #f1f1f1')
            button.cancelbtn(type='button') Cancel

    script(src='/js/validation.js')
