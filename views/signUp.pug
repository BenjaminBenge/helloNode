doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/css/index.css')
  title Sign Up
ul
  .home-space
    li
      a.active.home-btn(href='#home') Home
  li
    a.login-btn(href='#news') Stock
  li
    a.contact-btn(href='#contact') About
  li
    a.about-btn(href='/login') Login
h1  Sign Up
.space-around-manager-login
  .manager-login
    h4 Please enter your login details
    form#myForm(action='/userSignUp' onsubmit='return formValidate()' method="POST")
      .imgcontainer
        img.avatar(src='/img/flowers.jpg' alt='Avatar')
      div
        label(for='firstName') First Name:
        br
        br
        input#firstName(type='text' name='firstName')
        br
        br
        small#firstNameError.error-message
      div
        label(for='secondName') Second Name:
        br
        br
        input#secondName(type='text' name='secondName')
        br
        br
        small#secondNameError.error-message
      div
        label(for='email') Email:
        br
        br
        input#email(type='email' name='email')
        br
        br
        small#emailError.error-message
      div
        label(for='password') Password:
        br
        br
        input#password(type='password' name='password')
        br
        br
        br
        small#passwordError.error-message
      div
        label(for='confirmPassword') Confirm Password:
        br
        br
        input#confirmPassword(type='password' name='confirmPassword')
        br
        br
        br
        small#confirmPasswordError.error-message
      div
        label(for='dob') Date of Birth:
        br
        br
        input#dateOfBirth(type='date' name='dateOfBirth' )
        br
        br
        br
      div
        label(for='ninNumber') National ID Number:
        br
        br
        input#ninNumber(type='text' name='ninNumber')
        br
        br
        small#ninNumberError.error-message
      div
        label(for='phone') Phone Number:
        br
        br
        input#phone(type='text' name='phone')
        br
        br
        small#phoneError.error-message
      div
        label(for='maritalStatus') Marital Status:
        br
        br
        select#maritalStatus(name='maritalStatus')
          option(value='') --Select--
          option(value='Single') Single
          option(value='Married') Married
          option(value='Widow/Widower') Widow/Widower
        br
        br
      div
        label(for='branch') Branch :
        br
        br
        select#branch(name='branch')
          option(value='') --Select--
          option(value='Maganjo') Maganjo
          option(value='Matugga') Matugga
        br
        br
      div
        p Enter your Role here:
        br
        input#role(type='radio' name='role' value='Director')
        label(for='director') Director
        input#role(type='radio' name='role' value='Manager')
        label(for='manager') Manager
        input#role(type='radio' name='role' value='salesAgent')
        label(for='salesAgent') salesAgent
        br
        br
        small#roleError.error-message
      input#submitButton(type='submit' value='Submit')
      label
        input(type='checkbox' checked='checked' name='remember')
        |  Remember me
      .lower-login-section(style='background-color: #f1f1f1')
        button.cancelbtn(type='button') Cancel
        span.password
          | Forgot 
          a(href='#') password?
        span.create-account
          | Have an account? 
          a(href='/login') Login Instead
script(src='../js/signUpValidation.js')
