doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/css/index.css')
  ul
    .home-space
      li
        a.active.home-btn(href='#home') Home
    li
      a.login-btn(href='#news') Stock
    li
      a.contact-btn(href='#contact ') About
    li
      a.about-btn(href='#about ') SignUp
  title Document
h1 Add Product
.space-around-manager-login
  .manager-login
    h4 Please enter the product details
    form(action='/addProduct' method='post' enctype="multipart/form-data")
      .imgcontainer
        img.avatar(src='/img/flowers.jpg' alt='Avatar')
      label(for='image') Product Image
      br
      br
      input#fname(type='file' name='image' value='')
      br
      br
      label(for='productname') Product :
      br
      br
      select#productname(name='productname')
          option(value='Millet') Millet
          option(value='Cow Peas') Cow Peas 
          option(value='Beans') Beans
          option(value='Maize') Maize  
      br  
      label(for='typeOfProduct') Type Of Produce
      br
      br
      select#typeOfProduct(name='typeOfProduct')
          option(value='Flour') Flour
          option(value='Legumes') Legumes 
          option(value='Grains') Grains
      label(for='supplier') Supplier:
      br
      br
      select#supplier(name='supplier')
          option(value='Nana Suppliers') Nana Suppliers
          option(value='Simba Suppliers') Simba Suppliers
          option(value=' Dr.Kasenene') Dr.Kasenene
      label(for='dateOfPurchase') Date of Purchase:
      br
      input#dateOfPurchase(type='date' name='dateOfPurchase' value="")
      br
      br
      label(for='tonnage') Tonnage Bought
      br
      input#amountinkilos(type='text' name='tonnage' value='')
      br
      br
      label(for='unitprice') Unit Cost Ugx
      br
      input#unitprice(type='text' name='unitprice' value='')
      br
      br
      label(for='amountSpent') Total Spent
      br
      input#unitprice(type='text' name='amountSpent' value='')
      br
      br
      div
        label(for='branch') Branch :
        br
        br
        select#branch(name='branch')
          option(value='') --Select--
          option(value='Maganjo') Maganjo
          option(value='Matugga') Matugga
        br
      input(type='submit' value='Submit')
      .lower-login-section(style='background-color: #f1f1f1')
        button.cancelbtn(type='button') Cancel
      
       
