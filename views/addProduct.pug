doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='index.css')
  ul
    .home-space
      li
        a.active.home-btn(href='#home') Home
    li
      a.login-btn(href='#news') Stock
    li
      a.contact-btn(href='#contact ') About
    li
      a.about-btn(href='#about ') SignUp
  title Document
h1 Add Product
.space-around-manager-login
  .manager-login
    h4 Please enter the product details
    form(action='/addProduct' method='post' enctype="multipart/form-data")
      .imgcontainer
        img.avatar(src='/images/flowers.jpg' alt='Avatar')
      label(for='fname') Product Bought
      br
      input#fname(type='text' name='fname' value='')
      br
      br
      label(for='fname') Supplier Name
      br
      input#fname(type='text' name='fname' value='')
      br
      br
      label(for='fname') Type Of Produce
      br
      input#fname(type='text' name='fname' value='')
      br
      br
      label(for='lname') Date of Purchase:
      br
      input#password(type='date' name='password' value='')
      br
      br
      label(for='fname') Tonnage Bought
      br
      input#fname(type='text' name='fname' value='')
      br
      br
      label(for='fname') Cost Ugx
      br
      input#fname(type='text' name='fname' value='')
      br
      br
      div
        label(for='branch') Branch :
        br
        br
        select#branch(name='branch')
          option(value='') --Select--
          option(value='Maganjo') Maganjo
          option(value='Matugga') Matugga
        br
      input(type='submit' value='Submit')
      label
        input(type='checkbox' checked='checked' name='remember')
        |  Remember
        |             me
      .lower-login-section(style='background-color: #f1f1f1')
        button.cancelbtn(type='button') Cancel
        span.password
          | Forgot 
          a(href='#') password?
        span.create-account
          | Have no account? 
          a(href='#')  Create One
