doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet', href='/css/index.css')
    title Add Product

  body
    // Navbar (copied exactly from your existing layout)
    ul
      .home-space
        li
          a.active.home-btn(href='#home') Home
      li
        a.login-btn(href='#news') Stock
      li
        a.contact-btn(href='#contact') About
      li
        a.about-btn(href='#about') Login

    h1 Add Product

    .space-around-manager-login
      .manager-login
        h4 Please enter the product details

        form(action="/addProduct", method="post", enctype="multipart/form-data")
          .imgcontainer
            img.avatar(src="/img/flowers.jpg", alt="Default Product Image")

          label(for="image") Product Image
          br
          input(type="file", name="image", required)
          br
          br

          label(for="productname") Product:
          br
          input#productname(type="text", name="productname", required)
          br
          br

          label(for="typeOfProduct") Type Of Produce:
          br
          input#typeOfProduct(type="text", name="typeOfProduct")
          br
          br

          label(for="supplier") Supplier:
          br
          input#supplier(type="text", name="supplier")
          br
          br

          label(for="tonnage") Tonnage Bought (kg):
          br
          input#amountinkilos(type="number", name="tonnage", min="0", step="0.01", required)
          br
          br

          label(for="unitprice") Unit Cost (UGX per kg):
          br
          input#unitprice(type="number", name="unitprice", min="0", step="0.01", required)
          br
          br

          label(for="amountSpent") Total Spent (UGX):
          br
          input#amountSpent(type="number", name="amountSpent", readonly)
          br
          br

          label(for="branch") Branch:
          br
          input#branch(type="text", name="branch", value=branch || '', readonly)
          br
          br

          input(type="submit", value="Add Product")
          .lower-login-section(style="background-color: #f1f1f1")
            a(href="/products")
              button.cancelbtn(type="button") Cancel

    // Inline JavaScript to calculate total amount
    script.
      const qtyInput = document.getElementById('amountinkilos');
      const priceInput = document.getElementById('unitprice');
      const totalInput = document.getElementById('amountSpent');

      function updateTotal() {
        const qty = parseFloat(qtyInput.value) || 0;
        const price = parseFloat(priceInput.value) || 0;
        totalInput.value = (qty * price).toFixed(2);
      }

      if (qtyInput && priceInput) {
        qtyInput.addEventListener('input', updateTotal);
        priceInput.addEventListener('input', updateTotal);
      }
