doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet' href='/css/index.css')
  body
    ul
      .home-space
        li
          a.active.home-btn(href='/managerDash') Dashboard
      li
        a.login-btn(href='/addProduct') Add Product
      li
        a.contact-btn(href='/seeSales') Sales
      li
        a.about-btn(href='/logout') Logout

    h1 Products

    div
      table#customers
        tr
          th Image
          th Product Name
          th Supplier
          th Tonnage
          th Unit Price
          th Amount Spent
          th Date Of Purchase
          th Branch
          th Update
          th Make Sale
          th Credit Sale
          th Delete

        if products.length
          each product in products
            tr
              td
                img.product-img(
                  src='/img/uploads/' + product.image,
                  alt=product.productname,
                  width='100',
                  height='100',
                  style='border-radius: 5px; object-fit: cover;'
                )
              td #{product.productname}
              td #{product.supplier}
              td #{product.tonnage}
              td #{product.unitprice}
              td #{product.amountSpent}
              td #{moment(product.createdAt).format("YYYY-MM-DD HH:mm")}
              td #{product.branch}
              td
                a.btn.btn-update(href="/updateProduct/" + product._id) Update
              td
                a.btn.btn-sale(href="/addSale/" + product._id) Make Sale
              td
                a.btn.btn-sale(href="/addSale/" + product._id) Add Credit Sale

              td
                form(action="/deleteProduct" method="post")
                  input(type="hidden" name="id" value=product._id)
                  button.btn.btn-delete(type="submit") Delete
