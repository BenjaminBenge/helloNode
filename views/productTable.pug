doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  head
    // Required meta tags
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    link(rel='stylesheet' href='/css/index.css')
    ul
      .home-space
        li
          a.active.home-btn(href='#home') Home
      li
        a.login-btn(href='#news') Stock
      li
        a.contact-btn(href='#contact ') About
      li
        a.about-btn(href='#about ') Login
  h1 Products
  div
    div
    table#customers
      tr
        th Image
        th Product Name
        th Supplier
        th Tonnage
        th Unit Price
        th Amount Spent
        th dateOfPurchase
        th Branch
        th Update
        th Make Sale
        th Delete
      if products.length
        each product in products
          tr
            td
              img.product-img(src='/' + product.image, alt=product.productname height="100px" width="100px" border-radius="5px")
            td #{product.productname}
            td #{product.supplier}
            td #{product.tonnage}
            td #{product.unitprice}
            td #{product.amountSpent}
            td #{product.dateOfPurchase}
            td #{product.branch}
            td
              a.btn.btn-primary.btn-block(href="/updateProduct/"+product._id) Update 
            td 
              a.btn.btn-primary.btn-block(href="/updateProduct/"+product._id) Make Sale 
            td
              form(action="/deleteProduct" method = "post")
                   input(type="hidden" name="id" value=product._id)
                   button.btn.btn-danger.btn-block(type="submit") Delete 
      