doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet' href='/css/index.css')
    title Update Product
  body
    ul
      .home-space
        li
          a.active.home-btn(href='#home') Home
        li
          a.login-btn(href='#news') Stock
        li
          a.contact-btn(href='#contact') About
        li
          a.about-btn(href='#about') SignUp

    h1 Update Product
    .space-around-manager-login
      .manager-login
        h4 Please update the product details
        form(action='/updateProduct?id=' + product._id, method='post', enctype='multipart/form-data')
          .imgcontainer
            img.avatar(src='/img/flowers.jpg', alt='Avatar')

          label(for='image') Product Image
          br
          input(type='file', name='image')
          br
          br

          label(for='productname') Product Bought
          br
          input#productname(type='text', name='productname', value=product.productname)
          br
          br

          label(for='supplier') Supplier Name
          br
          input#supplier(type='text', name='supplier', value=product.supplier)
          br
          br

          label(for='typeOfProduct') Type Of Produce
          br
          input#typeOfProduct(type='text', name='typeOfProduct', value=product.typeOfProduct)
          br
          br

          label(for='dateOfPurchase') Date of Purchase:
          br
          input#dateOfPurchase(type='text' name='dateOfPurchase' value=product.formattedDate)
          br
          br
          label(for='amountinkilos') Tonnage Bought
          br
          input#amountinkilos(type='text', name='amountinkilos', value=product.amountinkilos)
          br
          br

          label(for='unitprice') Unit Cost Ugx
          br
          input#unitprice(type='text', name='unitprice', value=product.unitprice)
          br
          br

          label(for='amountSpent') Total Spent
          br
          input#amountSpent(type='text', name='amountSpent', value=product.amountSpent)
          br
          br

          label(for='branch') Branch :
          br
          select#branch(name='branch')
            option(value=product.branch)= product.branch
          br
          br

          input(type='submit', value='Update Product')

          .lower-login-section(style='background-color: #f1f1f1')
            button.cancelbtn(type='button') Cancel
