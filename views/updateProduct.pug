doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet' href='/css/index.css')
    title Update Product
  body
    ul
      .home-space
        li
          a.active.home-btn(href='#home') Home
      li
        a.login-btn(href='#news') Stock
      li
        a.contact-btn(href='#contact') About
      li
        a.about-btn(href='#about') SignUp

    h1 Update Product

    .space-around-manager-login
      .manager-login
        h4 Please update the product details
        form(action='/updateProduct?id=' + product._id, method='post', enctype='multipart/form-data')
          .imgcontainer
            img.avatar(src='/img/flowers.jpg', alt='Avatar')

          label(for='image') Product Image
          br
          input(type='file', name='image')
          br
          br

          label(for='productname') Product :
          br
          input#productname(type='text', name='productname', value=product.productname)
          br
          br

          label(for='typeOfProduct') Type Of Produce
          br
          input#typeOfProduct(type='text', name='typeOfProduct', value=product.typeOfProduct)
          br
          br

          label(for='supplier') Supplier:
          br
          input#supplier(type='text', name='supplier', value=product.supplier)
          br
          br

          label(for='tonnage') Tonnage Bought (kg):
          br
          input#amountinkilos(type='number', name='tonnage', min='0', step='0.01', value=product.tonnage)
          br
          br

          label(for='unitprice') Unit Cost (UGX per kg):
          br
          input#unitprice(type='number', name='unitprice', min='0', step='0.01', value=product.unitprice)
          br
          br

          label(for='amountSpent') Total Spent (UGX):
          br
          input#amountSpent(type='number', name='amountSpent', readonly, value=product.amountSpent)
          br
          br

          div
            label(for='branch') Branch
            br
            input#branch(type='text', name='branch', value=product.branch, readonly)
            br
            br

          input(type='submit', value='Update Product')
          .lower-login-section(style='background-color: #f1f1f1')
            button.cancelbtn(type='button') Cancel

    // Inline script for auto‑calculation of Total Spent
    script.
      const qtyInput = document.getElementById('amountinkilos');
      const priceInput = document.getElementById('unitprice');
      const totalInput = document.getElementById('amountSpent');

      function updateTotal() {
        const qty = parseFloat(qtyInput.value) || 0;
        const price = parseFloat(priceInput.value) || 0;
        totalInput.value = (qty * price).toFixed(2);
      }

      qtyInput.addEventListener('input', updateTotal);
      priceInput.addEventListener('input', updateTotal);
