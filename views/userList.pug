doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1.0')
  link(rel='stylesheet' href='/CSS/login.css')
  title Document
h2 Users List
.topnav
  a.active(href='#home') Home
  a(href='/managerDash') Manager
  a(href='/salesAgentDash') SalesAgent
  a(href='/directorDash') Director
div
  table
    thead 
      tr
        th First Name
        th Second Name
        th Phone Number
        th Role
        th branch
    tbody 
      if signups.length 
        each signup in signups
          tr
            td #{signup.firstName}
            td #{signup.secondName}
            td #{signup.phoneNumber}
            td #{signup.email}
            td #{signup.role}
            td #{signup.branch}
            
